<Project>
  <PropertyGroup>
    <!-- Opt-in only. The normal Release build remains framework-dependent
         until live keyboard, tray, overlay, Undo and settings tests are run
         against this profile on target machines. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
