<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInput.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:Class="SmartInput.App.Views.KbmPreviewView"
             x:DataType="vm:KbmPreviewViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" MaxWidth="960">
      <StackPanel Spacing="8">
        <TextBlock Text="Сравнение с KBM"
                   Classes="page-title" />
        <TextBlock Text="Безопасный предпросмотр recovered-модели. Здесь ничего не меняется в других приложениях и не отправляется в интернет."
                   Classes="page-subtitle"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card hero">
        <StackPanel Spacing="12">
          <TextBlock Text="1. Введите токен"
                     Classes="card-title" />
          <TextBox Text="{Binding SourceToken, Mode=TwoWay}"
                   Watermark="Например: commersant"
                   AutomationProperties.Name="Токен для KBM preview" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Маршрут подготовки:"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding RouteOptions}"
                      SelectedItem="{Binding SelectedRoute}"
                      Width="250"
                      DisplayMemberBinding="{Binding Title}"
                      AutomationProperties.Name="Маршрут KBM" />
          </StackPanel>
          <TextBlock Text="Маршрут выбирается явно. Провайдер не перебирает варианты и не делает нечёткий поиск."
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="2. Результаты сравнения"
                     Classes="card-title" />
          <TextBlock Text="{Binding ComparisonStatus}"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*">
            <Border Grid.Column="0" Classes="card" Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Текущий SmartInput"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding OwnDecision}" />
                <TextBlock Text="{Binding OwnResult}"
                           FontSize="18"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="14" Margin="16,0,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="Recovered KBM"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding KbmResult}"
                           FontSize="18"
                           TextWrapping="Wrap" />
                <TextBlock Text="Кандидат только наблюдается — кнопки внешнего применения здесь нет."
                           Classes="muted"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock Text="{Binding TechnicalDetails}"
                     Classes="muted"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Сравнить"
                    Command="{Binding AnalyzeCommand}" />
            <Button Content="Очистить"
                    Command="{Binding ClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card warning">
        <TextBlock Text="Важно: KBM пока работает только в audit/preview. Любая внешняя замена остаётся за единым live-пайплайном SmartInput, его Safety Policy и Double Shift Undo."
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
