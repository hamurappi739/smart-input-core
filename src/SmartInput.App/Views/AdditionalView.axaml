<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInput.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="720"
             x:Class="SmartInput.App.Views.AdditionalView"
             x:DataType="vm:AdditionalViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
      <TextBlock Text="Дополнительно"
                 Classes="page-title" />
      <TextBlock Text="Редкие настройки собраны здесь, чтобы главная страница оставалась простой."
                 Classes="page-subtitle" />
    </StackPanel>

    <TabControl Grid.Row="1"
                SelectedIndex="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
      <TabItem Header="Параметры исправлений">
        <ContentControl Content="{Binding Corrections}" />
      </TabItem>
      <TabItem Header="Безопасность приложений">
        <ContentControl Content="{Binding Applications}" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
